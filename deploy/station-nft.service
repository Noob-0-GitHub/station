[Unit]
Description=Station network rules (instance users: no local ports below 10000, no private networks)
After=nftables.service ufw.service


[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/station/station.nft
ExecStop=/usr/sbin/nft delete table inet station

[Install]
WantedBy=multi-user.target
